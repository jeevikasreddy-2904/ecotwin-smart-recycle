        .et-icon { font-size: 24px; }
        .et-muted { color: var(--et-muted); font-size: 13px; }
        .et-value { font-size: clamp(24px, 3vw, 32px); font-weight: 800; margin: 15px 0 7px; }
        .et-detail { line-height: 1.5; }
        .et-section-title {
          display: flex; justify-content: space-between; align-items: center;
          flex-wrap: wrap; gap: 10px; margin-bottom: 16px;
        }
        .et-section-title h2 { margin: 0; font-size: 19px; }
        .et-two-col {
          display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
          gap: 16px; margin-bottom: 20px;
        }
        .et-progress-track {
          height: 13px; width: 100%; border-radius: 20px;
          background: #294238; overflow: hidden; margin: 14px 0;
        }
        .et-progress-fill {
          height: 100%; border-radius: 20px; background: var(--et-green);
          transition: width .8s ease;
        }
        .et-breakdown { display: grid; gap: 15px; margin-top: 20px; }
        .et-break-row { display: flex; justify-content: space-between; gap: 10px; font-size: 14px; }
        .et-break-row strong { text-align: right; }
        .et-bin {
          padding: 14px 0; border-bottom: 1px solid var(--et-border);
        }
        .et-bin:last-child { border-bottom: 0; }
        .et-bin-top { display: flex; justify-content: space-between; gap: 12px; }
        .et-bin-name { font-weight: 700; }
        .et-pill {
          display: inline-block; padding: 5px 9px; border-radius: 20px;
          font-size: 11px; font-weight: 800;
        }
        .et-green { background: #14532d; color: #bbf7d0; }
        .et-yellow { background: #713f12; color: #fef3c7; }
        .et-red { background: #7f1d1d; color: #fecaca; }
        .et-stop {
          display: flex; align-items: flex-start; gap: 12px;
          padding: 13px 0; border-bottom: 1px solid var(--et-border);
        }
        .et-stop:last-child { border-bottom: 0; }
        .et-dot {
          flex: 0 0 12px; width: 12px; height: 12px;
          border-radius: 50%; margin-top: 5px;
        }
        .et-dot.visited { background: #4ade80; box-shadow: 0 0 10px #4ade8055; }
        .et-dot.missed { background: #f87171; box-shadow: 0 0 10px #f8717155; }
        .et-stop-content { flex: 1; min-width: 0; }
        .et-stop-content strong { display: block; font-size: 14px; }
        .et-stop-content small { display: block; color: var(--et-muted); margin-top: 5px; }
