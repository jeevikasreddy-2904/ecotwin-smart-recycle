        <select
          className="et-year"
          value={year}
          onChange={(event) => setYear(Number(event.target.value) as 2025 | 2026 | 2027)}
          aria-label="Select sustainability year"
        >
          <option value={2025}>Year 2025</option>
          <option value={2026}>Year 2026</option>
          <option value={2027}>Year 2027 goal</option>
        </select>
      </div>

      <section className="et-grid">
        <StatCard
          icon="♻️"
          title="Recycled"
          value={`${data.recycled.toLocaleString()} kg`}
          detail="Material sent for recycling"
        />
        <StatCard
          icon="🌱"
          title="Composted"
          value={`${data.composted.toLocaleString()} kg`}
          detail="Organic waste composted"
        />
        <StatCard
          icon="🗑️"
          title="Disposed"
          value={`${data.disposed.toLocaleString()} kg`}
          detail="Waste sent for disposal"
        />
        <StatCard
          icon="🌍"
          title="CO₂ avoided"
