      </section>

      <section className="et-two-col">
        <article className="et-panel">
          <div className="et-section-title">
            <h2>🚛 Route Stop Report</h2>
            <span className="et-muted">Sample shift data</span>
          </div>
          <div className="et-muted" style={{ marginBottom: 12 }}>
            Green = visited · Red = missed
          </div>
          {demoStops.map((stop) => (
            <div className="et-stop" key={stop.name}>
              <span className={`et-dot ${stop.status === "Visited" ? "visited" : "missed"}`} />
              <div className="et-stop-content">
                <strong>{stop.name}</strong>
                <small>{stop.time}</small>
              </div>
              <span className={`et-pill ${stop.status === "Visited" ? "et-green" : "et-red"}`}>
                {stop.status}
              </span>
            </div>
          ))}
          <p className="et-note">
