                <span>Composting</span><strong>{data.composted.toLocaleString()} kg</strong>
              </div>
              <div className="et-progress-track">
                <div className="et-progress-fill" style={{ width: `${Math.min(100, (data.composted / data.goal) * 100)}%` }} />
