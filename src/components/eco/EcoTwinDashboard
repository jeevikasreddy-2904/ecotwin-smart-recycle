            <h2>📊 Sustainability Summary</h2>
          </div>
          <div className="et-breakdown">
            <div className="et-break-row">
              <span>Recycled + composted</span>
              <strong>{totalProcessed.toLocaleString()} kg</strong>
            </div>
            <div className="et-break-row">
              <span>Total waste recorded</span>
              <strong>{(totalProcessed + data.disposed).toLocaleString()} kg</strong>
