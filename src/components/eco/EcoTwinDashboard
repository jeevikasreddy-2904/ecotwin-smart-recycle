  { id: "BIN-001", name: "Recycling Bin", place: "DSU Campus", fill: 78, type: "Recyclable" },
  { id: "BIN-002", name: "Organic Waste Bin", place: "Harohalli", fill: 91, type: "Organic" },
  { id: "BIN-003", name: "Plastic Waste Bin", place: "Industrial Area", fill: 46, type: "Plastic" },
  { id: "BIN-004", name: "Mixed Waste Bin", place: "Kanakapura", fill: 64, type: "Mixed" },
];

const demoStops = [
  { name: "Kanakapura Collection Point", status: "Visited", time: "08:15 AM" },
  { name: "DSU Campus Smart Bin", status: "Visited", time: "09:05 AM" },
  { name: "JAIN University Area", status: "Missed", time: "10:10 AM" },
  { name: "Industrial Area, Harohalli", status: "Visited", time: "11:20 AM" },
  { name: "Harohalli Bus Stand", status: "Missed", time: "12:00 PM" },
];

function StatCard({
  icon,
  title,
  value,
  detail,
}: {
  icon: string;
  title: string;
  value: string;
  detail: string;
}) {
  return (
    <article className="et-card">
      <div className="et-stat-top">
        <span className="et-icon">{icon}</span>
        <span className="et-muted">{title}</span>
      </div>
      <div className="et-value">{value}</div>
      <div className="et-muted et-detail">{detail}</div>
    </article>
  );
}

