            Demo target for {year}. Replace these sample values with verified collection
            and weighing records before using this for official sustainability reporting.
          </p>
        </article>

        <article className="et-panel">
          <div className="et-section-title">
            <h2>🧠 Smart Bin Monitoring</h2>
            <span className="et-pill et-green">{demoBins.length} demo bins</span>
          </div>
          <label className="et-muted">
            Filter bin type{" "}
            <select
              className="et-filter"
              value={binFilter}
              onChange={(event) => setBinFilter(event.target.value)}
            >
              <option>All</option>
              <option>Recyclable</option>
              <option>Organic</option>
              <option>Plastic</option>
              <option>Mixed</option>
            </select>
          </label>

          {bins.map((bin) => (
            <div className="et-bin" key={bin.id}>
              <div className="et-bin-top">
                <div>
                  <div className="et-bin-name">{bin.name}</div>
                  <div className="et-muted" style={{ marginTop: 5 }}>
                    {bin.id} · {bin.place}
                  </div>
                </div>
                <span className={`et-pill ${bin.fill >= 80 ? "et-red" : bin.fill >= 60 ? "et-yellow" : "et-green"}`}>
                  {bin.fill >= 80 ? "Needs collection" : bin.fill >= 60 ? "Filling up" : "Available"}
                </span>
              </div>
              <div className="et-progress-track">
                <div
                  className="et-progress-fill"
                  style={{
                    width: `${bin.fill}%`,
                    background: bin.fill >= 80 ? "#f87171" : bin.fill >= 60 ? "#facc15" : "#4ade80",
