          font-family: Inter, system-ui, sans-serif;
        }
        .et-dashboard * { box-sizing: border-box; }
        .et-heading {
          display: flex; align-items: center; justify-content: space-between;
          gap: 16px; flex-wrap: wrap; margin-bottom: 22px;
        }
        .et-heading h1 { margin: 0; font-size: clamp(24px, 4vw, 34px); }
        .et-heading p { margin: 7px 0 0; color: var(--et-muted); }
